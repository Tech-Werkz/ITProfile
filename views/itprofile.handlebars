<script>
    "use strict";
    console.log("🚀 IT Profile Plugin UI injected from views!");

    pluginHandler.registerPlugin({
        name: "itprofile",
        
        onDeviceSetup: function() {
            console.log("IT Profile: onDeviceSetup function triggered!");
            if ($('#tabitprofile').length === 0) {
                $('#deviceTabs').append('<a id="tabitprofile" href="#" onclick="itprofile_ShowTab()" class="nav-item nav-link">IT Profile</a>');
            }
        },
        
        onPluginMessage: function(msg) {
            if(msg.plugin === 'itprofile' && msg.method === 'healthData') {
                $('#itprofile_results').html('<pre>' + msg.data + '</pre>');
            }
        }
    });
</script>
